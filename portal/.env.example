# ------- Supabase (project: supabase-bistre-zebra) -------
# On Vercel these three are filled in for you when the Supabase store is
# connected to the project (Storage tab > supabase-bistre-zebra > Connect Project).
NEXT_PUBLIC_SUPABASE_URL=https://oofjtxewbgjlgbxrttxa.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------- Resend (sign-in codes and customer report emails) -------
# Without a key, emails are printed to the server log instead of sent.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
EMAIL_FROM="Southwest Home Maintenance <reports@your-domain.com>"
# Optional: where a customer's reply to a report should land.
EMAIL_REPLY_TO=you@your-domain.com

# ------- App -------
# Public address of the portal, used in email links. On Vercel this can be left
# out: the address Vercel assigns is used.
APP_URL=https://portal.your-domain.com
# Comma-separated emails that become owners the first time they sign in.
PORTAL_OWNER_EMAILS=you@your-domain.com

{
  "name": "southwest-home-maintenance-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-checklist": "node scripts/sync-checklist.mjs",
    "predev": "node scripts/sync-checklist.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-checklist.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db:reset": "node scripts/test-db.mjs reset",
    "test:db:check": "node scripts/test-db.mjs check",
    "verify": "npm run typecheck && npm run test && npm run test:e2e",
    "demo:video": "playwright test -c playwright.demo.config.ts && node tests/demo/compose.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",

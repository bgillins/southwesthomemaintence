---
// ------- Header -------
// Sticky bar with the logo, section links, and a click-to-call button that is always in reach.
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import Icon from './Icon.astro';
import { site } from '../data/site';

const links = [
  { href: '#what-we-do', label: 'What we do' },
  { href: '#how-it-works', label: 'How it works' },
  { href: '#plans', label: 'Plans' },
  { href: '#faq', label: 'Questions' },
];
---

<header class="header">
  <div class="wrap bar">
    <a class="logo" href="/" aria-label={`${site.name} home`}>
      <Image src={logo} alt={site.name} width={400} loading="eager" />
    </a>

    <nav class="nav" aria-label="Main">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <div class="actions">
      <a class="call" href={site.phoneHref}>
        <Icon name="phone" size={20} />
        <span class="call-label">Call</span>
        <span class="call-number">{site.phoneDisplay}</span>
      </a>
      <a class="btn btn--gold start" href="#get-started">Get started</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(247 243 232 / 0.94);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(8px);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 5rem;
  }

  .logo img {
    width: auto;
    height: 3.5rem;
  }

  /* ------- Section links (desktop only) ------- */
  .nav {
    display: none;
    gap: 1.75rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .nav a {
    padding-block: 0.5rem;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .nav a:hover {
    border-bottom-color: var(--gold);
  }

  /* ------- Call + sign-up buttons ------- */
  .actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .call {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0.5rem 1rem;
    border: 2px solid var(--navy);
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .call:hover {
    background: var(--navy);
    color: var(--cream);
  }

  /* Phones show "Call"; wider screens show the full number */
  .call-number {
    display: none;
  }

  .start {
    display: none;
    min-height: 3rem;
    padding-block: 0.5rem;
    font-size: 1rem;
  }

  @media (min-width: 40rem) {
    .call-label {
      display: none;
    }

    .call-number,
    .start {
      display: inline-flex;
    }
  }

  @media (min-width: 64rem) {
    .nav {
      display: flex;
    }

    .logo img {
      height: 4rem;
    }
  }
</style>

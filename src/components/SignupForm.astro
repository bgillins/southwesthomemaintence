---
// ------- Get started -------
// Short request form. Submissions are sent to `site.formEndpoint` (see src/data/site.ts).
// Until that endpoint is set, nothing is sent and the visitor is asked to call instead.
import Icon from './Icon.astro';
import { site } from '../data/site';
import { plans, assessment } from '../data/plans';
---

<section class="section section--navy" id="get-started">
  <div class="wrap grid">
    <!-- ------- Pitch and phone number ------- -->
    <div>
      <p class="eyebrow">Get started</p>
      <h2>Get on the list</h2>
      <p class="lead">
        Tell us a little about your home. We'll call to answer your questions and schedule your{' '}
        {assessment.name}. There's nothing to pay today.
      </p>

      <p class="or">Rather talk to a person?</p>
      <a class="phone" href={site.phoneHref}>
        <Icon name="phone" size={26} />
        {site.phoneDisplay}
      </a>
    </div>

    <!-- ------- Form ------- -->
    <form class="form" id="signup-form" data-endpoint={site.formEndpoint} data-phone={site.phoneDisplay}>
      <div class="field">
        <label for="name">Your name</label>
        <input id="name" name="name" type="text" autocomplete="name" required />
      </div>

      <div class="field">
        <label for="phone">Phone number</label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
      </div>

      <div class="field">
        <label for="email">Email <span class="optional">(optional)</span></label>
        <input id="email" name="email" type="email" autocomplete="email" />
      </div>

      <div class="field">
        <label for="zip">ZIP code</label>
        <input
          id="zip"
          name="zip"
          type="text"
          autocomplete="postal-code"
          inputmode="numeric"
          pattern="[0-9]{5}"
          maxlength="5"
          title="Five-digit ZIP code"
          required
        />
      </div>

      <div class="field field--wide">
        <label for="plan">Plan you're interested in</label>
        <select id="plan" name="plan">
          <option value="">Not sure yet</option>
          {
            plans.map((plan) => (
              <option value={plan.id}>
                {plan.name}: ${plan.price} a month, {plan.visits}
              </option>
            ))
          }
        </select>
      </div>

      <fieldset class="field field--wide choices">
        <legend>Best way to reach you</legend>
        <label><input type="radio" name="contact" value="call" checked /> Phone call</label>
        <label><input type="radio" name="contact" value="text" /> Text</label>
        <label><input type="radio" name="contact" value="email" /> Email</label>
      </fieldset>

      <button class="btn btn--gold btn--block field--wide" type="submit">Request my assessment</button>

      <!-- Result message, announced to screen readers when it changes -->
      <p class="status field--wide" id="signup-status" role="status" aria-live="polite" hidden></p>
    </form>
  </div>
</section>

<script>
  // ------- Plan buttons: pre-select the chosen plan -------
  // Any link with data-plan="plus" (the plan cards) sets the dropdown before the page scrolls here.
  const planSelect = document.querySelector<HTMLSelectElement>('#plan');
  document.querySelectorAll<HTMLAnchorElement>('a[data-plan]').forEach((link) => {
    link.addEventListener('click', () => {
      if (planSelect && link.dataset.plan) planSelect.value = link.dataset.plan;
    });
  });

  // ------- Form submission -------
  const form = document.querySelector<HTMLFormElement>('#signup-form');
  const status = document.querySelector<HTMLParagraphElement>('#signup-status');

  function showStatus(message: string, kind: 'ok' | 'error') {
    if (!status) return;
    status.textContent = message;
    status.dataset.kind = kind;
    status.hidden = false;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const endpoint = form.dataset.endpoint;
    const phone = form.dataset.phone;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    // No endpoint configured yet: be honest that nothing was sent.
    if (!endpoint) {
      showStatus(`Online requests aren't switched on yet. Please call us at ${phone}.`, 'error');
      return;
    }

    try {
      if (button) button.disabled = true;
      const response = await fetch(endpoint, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(`Form endpoint answered ${response.status}`);
      form.reset();
      showStatus("Thank you. We've got your request and will be in touch soon.", 'ok');
    } catch {
      showStatus(`Sorry, that didn't go through. Please try again or call us at ${phone}.`, 'error');
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>

<style>
  .grid {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
      gap: 4.5rem;
    }
  }

  /* ------- Left column ------- */
  .lead {
    margin-top: 1.25rem;
    font-size: 1.25rem;
    color: var(--cream-muted);
  }

  .or {
    margin-top: 2.5rem;
    font-weight: 600;
    color: var(--cream-muted);
  }

  .phone {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.375rem;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 650;
    color: var(--gold);
    text-decoration: none;
  }

  .phone:hover {
    text-decoration: underline;
  }

  /* ------- Form card ------- */
  .form {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--navy);
  }

  @media (min-width: 36rem) {
    .form {
      grid-template-columns: 1fr 1fr;
    }

    .field--wide {
      grid-column: 1 / -1;
    }
  }

  .field {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  label,
  legend {
    padding: 0;
    font-size: 1rem;
    font-weight: 700;
  }

  .optional {
    font-weight: 500;
    color: var(--navy-muted);
  }

  input[type='text'],
  input[type='tel'],
  input[type='email'],
  select {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.5rem 0.875rem;
    border: 2px solid #9aa8b3;
    border-radius: 0.625rem;
    background: var(--white);
    color: var(--navy);
    font: inherit;
  }

  input:focus-visible,
  select:focus-visible {
    border-color: var(--navy);
  }

  /* ------- Contact preference radios ------- */
  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .choices legend {
    width: 100%;
    margin-bottom: 0.375rem;
  }

  .choices label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-weight: 500;
    cursor: pointer;
  }

  .choices input {
    width: 1.375rem;
    height: 1.375rem;
    margin: 0;
    accent-color: var(--navy);
  }

  /* ------- Result message ------- */
  .status {
    padding: 0.875rem 1rem;
    border-radius: 0.625rem;
    font-weight: 600;
  }

  .status[data-kind='ok'] {
    background: var(--olive-tint);
    color: var(--olive-ink);
  }

  .status[data-kind='error'] {
    background: var(--gold-tint);
    color: var(--gold-ink);
  }
</style>

---
// ------- What we take care of -------
// The core checklist in plain words. Each item is a job people tend to put off.
import Icon from './Icon.astro';

const items = [
  {
    icon: 'air',
    title: 'Air filters',
    text: 'Replaced on schedule, with the right size on hand for your system.',
  },
  {
    icon: 'bulb',
    title: 'Light bulbs',
    text: 'Burnt-out bulbs replaced, including the oven light and the ones that are awkward to reach.',
  },
  {
    icon: 'alarm',
    title: 'Smoke and CO alarms',
    text: 'Tested every visit, with fresh batteries once a year.',
  },
  {
    icon: 'search',
    title: 'Leak checks',
    text: 'A look under every sink and around toilets, the water heater and the laundry.',
  },
  {
    icon: 'drop',
    title: 'Water softener',
    text: "Salt topped off and the setting checked against the valley's hard water.",
  },
  {
    icon: 'home',
    title: 'Garage door',
    text: 'Safety reverse tested and the moving parts kept lubricated.',
  },
  {
    icon: 'flame',
    title: 'Dryer lint',
    text: 'Lint cleared from the places the screen misses, a common cause of dryer fires.',
  },
  {
    icon: 'sun',
    title: 'Seasonal checks',
    text: 'Getting the house ready for summer heat, monsoon storms and winter cold snaps.',
  },
] as const;
---

<section class="section section--white" id="what-we-do">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">What we take care of</p>
      <h2>The home maintenance jobs that are easy to put off</h2>
      <p>
        None of these are hard. They're just easy to forget, awkward to reach, or one more thing on
        the list. We do them for you, on a schedule.
      </p>
    </div>

    <ul class="grid">
      {
        items.map((item) => (
          <li class="item">
            <span class="icon">
              <Icon name={item.icon} size={26} />
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 2rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .item {
      flex-direction: column;
    }
  }

  .item {
    display: flex;
    gap: 1rem;
  }

  .icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--cream);
    color: var(--olive-dark);
  }

  .item p {
    margin-top: 0.375rem;
    font-size: 1.0625rem;
    color: var(--navy-muted);
  }
</style>
